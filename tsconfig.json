{
  "compilerOptions": {
    "target": "es2021",
    "module": "commonjs",
    "outDir": "./bin",
    "baseUrl": ".",
    "paths": {
      "@t21n/solix-api": ["../solix-api/src/index"]
    },
    "isolatedModules": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "noImplicitAny": true,
    "skipLibCheck": true
  }
}
